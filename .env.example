# Foldo — environment variables.
# All vars have sensible localhost defaults; `npm run dev` works with an empty
# .env. Copy this file to `.env` only if you need to override something locally.

# ============================================================================
# apps/server  (Fastify + Postgres, port 4000)
# ============================================================================

# Port the server binds to. Railway sets this automatically; honour it.
# Default: 4000
PORT=4000

# Fastify log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Postgres connection string. REQUIRED. Locally:
#   postgres://USER@localhost:5432/foldo
# On Railway, set this to ${{Postgres.DATABASE_URL}} so it follows the plugin.
DATABASE_URL=postgres://localhost:5432/foldo

# Optional connection pool size. Default: 10
# DATABASE_POOL_MAX=10

# Comma-separated list of additional CORS origins to allow, on top of the
# built-in localhost:5173 / localhost:5174 / chrome-extension://* defaults.
# Example: FOLDO_WEB_ORIGIN=https://foldo.dev,https://sample.foldo.dev
# FOLDO_WEB_ORIGIN=

# Public URL of the sample-app (used by the dispatch simulator + seed when
# generating iframe URLs).
# Default: http://localhost:5174
# FOLDO_SAMPLE_APP_URL=https://sample.foldo.dev

# Public origin used when minting share-link URLs (`/share/:token`). Should
# match the user-facing web origin in production.
# Default: http://localhost:5173
# FOLDO_PUBLIC_WEB_ORIGIN=https://foldo.dev

# --- User Tests: recording storage ---------------------------------------
# Where test-session recordings live. With no S3 config, recordings are
# written to a local directory (ephemeral on most PaaS — fine for dev, NOT
# for production). Default: <apps/server cwd>/.foldo-storage
# FOLDO_STORAGE_DIR=/data/foldo-storage
#
# Set FOLDO_S3_BUCKET to switch to S3-compatible object storage (AWS S3,
# Cloudflare R2, Backblaze B2 — recommended for production).
# FOLDO_S3_BUCKET=foldo-recordings
# FOLDO_S3_REGION=auto
# FOLDO_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  # R2/B2 only
# FOLDO_S3_ACCESS_KEY=
# FOLDO_S3_SECRET=

# --- User Tests: transcription + AI synthesis ----------------------------
# Transcription provider for session recordings. Unset = a stub that records
# "(transcription provider not configured)". Real providers are a future
# drop-in (e.g. deepgram).
# FOLDO_TRANSCRIPTION_PROVIDER=deepgram
#
# When set, completed sessions get a real Claude-generated synthesis
# (summary + extracted issues). Unset = a heuristic stub synthesis.
# ANTHROPIC_API_KEY=
# FOLDO_SYNTHESIS_MODEL=claude-opus-4-7

# ============================================================================
# apps/web  (Vite/React canvas + marketing, port 5173)
# These are BUILD-TIME vars — they're inlined into the JS bundle by Vite.
# Set them before `vite build` (Railway: service build vars).
# ============================================================================

# REST API base URL. Default: http://localhost:4000
# VITE_API_URL=https://api.foldo.dev

# WebSocket base URL (optional). If unset, derived from VITE_API_URL.
# VITE_WS_URL=wss://api.foldo.dev

# Sample app base URL (used by the canvas to iframe the preview).
# Default: http://localhost:5174
# VITE_SAMPLE_URL=https://sample.foldo.dev

# Shotter (server-side screenshot fallback). When unset, /c/<url> falls back
# only to the Chrome extension. Format: full origin, no trailing slash.
# In dev, set this to the local shotter — run it alongside the rest of the
# stack with `FOLDO_SHOTTER_DEV=1 npm run dev` (port 5175). With this set,
# the canvas "Capture from URL" modal posts to the shotter and ships the
# returned PNG as an image frame instead of the iframe-only fallback.
# VITE_SHOTTER_URL=http://localhost:5175

# ============================================================================
# apps/sample-app  (port 5174)
# Inherits PORT from Railway in production.
# ============================================================================

# The canvas origin allowed to drive this app via postMessage.
# Default: http://localhost:5173
# VITE_PARENT_ORIGIN=https://foldo.dev

# ============================================================================
# apps/shotter  (port 5175 in dev, opt-in via FOLDO_SHOTTER_DEV=1)
# Headless-chromium screenshot service that backs the canvas's "Capture from
# URL" modal when no extension is loaded.
# ============================================================================

# Optional bearer secret. UNSET in dev = no auth (matches the canvas's
# default fetch). In production, set this on BOTH the shotter service and
# any caller; requests without `Authorization: Bearer <secret>` get 401.
# FOLDO_SHOT_SECRET=

# Shotter port (Railway sets PORT in prod; dev uses 5175 unless overridden).
# PORT=5175
