    "istextorbinary": "^9.5.0",
    "jose": "^5.6.3",
    "nanostores": "^0.10.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^4.5.0",
    "react-markdown": "^9.0.1",
