{
  "name": "foldo",
  "description": "Foldo: vibe-code web apps in the browser",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "node --env-file-if-exists=.env node_modules/@remix-run/dev/dist/cli.js vite:dev",
    "test": "vitest --run",
    "test:watch": "vitest",
    "start": "node --env-file-if-exists=.env server.mjs",
    "typecheck": "tsc",
    "art": "node scripts/gen-art.mjs && python3 scripts/art-postprocess.py",
    "test:e2e": "node scripts/e2e-security.mjs",
    "templates": "node scripts/build-templates.mjs",
    "prebuild": "node scripts/build-templates.mjs",
    "predev": "node scripts/build-templates.mjs",
    "test:templates": "node scripts/verify-templates.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
