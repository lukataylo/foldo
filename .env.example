# --- required in production ---
APP_SECRET=            # openssl rand -hex 32. Encrypts provider API keys stored via /admin.
ADMIN_EMAILS=          # comma-separated; these accounts get /admin
DB_PATH=/data/foldo.db # Railway: mount a volume at /data

# --- model keys: either paste them in /admin later, or set env vars here ---
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MIMO_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
LLM_PROVIDER=openrouter  # default model; changeable in /admin

# --- hackathon knobs (all also editable in /admin) ---
INVITE_CODE=           # blank = open sign-up
EVENT_NAME=
EVENT_ENDS_AT=         # ISO date, shows a countdown
DAILY_MESSAGE_LIMIT=50 # per team per day
GLOBAL_DAILY_LIMIT=5000
MAX_CONCURRENT_STREAMS=40
